{
  "name": "Lockdown",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "installGradle": true,
      "gradleVersion": "8.11.1"
    }
  },
  "postCreateCommand": "python -m venv .venv && .venv/bin/python -m pip install -r api/requirements-dev.txt",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "Lockdown API",
      "onAutoForward": "silent"
    }
  }
}
